PORT=5000

DATABASE_HOST=localhost
DATABASE_USER=root
DATABASE_PASSWORD=your_mysql_password
DATABASE_NAME=utsanova_blog
DATABASE_PORT=3306

FIREBASE_ADMIN_PROJECT_ID=your-firebase-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

GEMINI_API_KEY=

# Allows the "Create Admin Account" form to insert the new Firebase user into the MySQL
# admins table (after the backend verifies their Firebase ID token). Set to true to enable.
# WARNING: when true, ANYONE who can reach the site can become an admin.
ADMIN_SELF_REGISTRATION=true

# Cloudinary (image storage for blog images) - BACKEND ONLY, never prefix with VITE_
# Dashboard: https://console.cloudinary.com  ->  Settings -> API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Optional: Cloudinary folder the blog images are stored in (default: utsanova-blog)
CLOUDINARY_FOLDER=utsanova-blog

# --- Permission-based access control (migration 004) ---------------------------------------------
# BOOTSTRAP owner(s): Firebase UID(s), comma separated (Firebase Console > Authentication > Users > User UID).
# These are always owners, need no database row, and cannot be removed through the app, so you can never be
# locked out. Further owners are managed in the app (Manage Users > Make owner; stored in admins.is_owner).
# An email address never grants ownership.
OWNER_FIREBASE_UID=

# --- Scheduled publishing (GitHub Actions cron) ---------------------------------------------------
# Long random secret (>= 32 chars), e.g.:  openssl rand -hex 32
# Must be identical in GitHub (Secrets) and in this deployment environment. Never commit it.
CRON_SECRET=
